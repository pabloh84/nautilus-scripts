#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2001

# Source the script '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local output_dir=""

    # Execute initial checks.
    _check_dependencies ""
    _display_wait_box
    input_files=$(_get_files "par_type=all")

    if [[ -z "$input_files" ]]; then
        _close_wait_box
        return 0
    fi

    _generate_plan "$input_files"
    local changes_count=$?

    _close_wait_box

    if ((changes_count == 0)); then
        _display_info_box "$(_i18n 'No files need cleaning or renaming.')"
        return 0
    fi

    if ! _display_plan_box; then
        return 0
    fi

    _display_wait_box

    # Export functions for parallel execution worker processes.
    export -f _main_task \
        _clean_up_item \
        _is_release_folder \
        _clean_up_single_media \
        _resolve_media_target \
        _detect_sub_lang \
        _parse_tv_show \
        _parse_movie \
        _parse_audiobook \
        _clean_artist \
        _sanitize_special_chars \
        _get_audio_metadata \
        _get_online_book_metadata \
        _find_local_movie_year \
        _get_online_movie_year \
        _update_or_create_m3u \
        _strip_junk_tags \
        _title_case

    # Execute the function '_main_task' for each item in parallel.
    _run_task_parallel "$input_files" "$output_dir"
    _display_result_box ""
}

_display_plan_box() {
    local btn_ok=""
    btn_ok="$(_i18n 'Apply Plan')"
    local btn_cancel=""
    btn_cancel="$(_i18n 'Cancel')"

    _display_lock
    if ! _is_gui_session; then
        cat "$TEMP_DATA_TEXT_BOX" >&2
        echo -e -n "\nApply this plan? [Y/n] " >&2
        local response=""
        read -r response </dev/tty
        [[ ${response,,} == *"n"* ]] && { _display_unlock; return 1; }
    elif _command_exists "zenity"; then
        zenity --title "$(_get_script_name) - Proposed Plan" \
            --no-markup --width="$GUI_BOX_WIDTH" --height="$GUI_BOX_HEIGHT" \
            --cancel-label="${btn_cancel}" --ok-label="${btn_ok}" \
            --text-info --no-wrap \
            --filename="$TEMP_DATA_TEXT_BOX" &>/dev/null || { _display_unlock; return 1; }
    elif _command_exists "yad"; then
        yad --title "$(_get_script_name) - Proposed Plan" --center \
            --no-markup --width="$GUI_BOX_WIDTH" --height="$GUI_BOX_HEIGHT" \
            --button="${btn_cancel}:1" --button="${btn_ok}:0" \
            --text-info --no-wrap \
            --filename="$TEMP_DATA_TEXT_BOX" &>/dev/null || { _display_unlock; return 1; }
    elif _command_exists "xmessage"; then
        xmessage -title "$(_get_script_name) - Proposed Plan" \
            -buttons "${btn_cancel}:1,${btn_ok}:0" \
            -file "$TEMP_DATA_TEXT_BOX" &>/dev/null || { _display_unlock; return 1; }
    fi
    _display_unlock

    return 0
}

_sanitize_special_chars() {
    local text=$1
    text=$(echo "$text" | sed "s/\*/-/g; s/:/ -/g; s/[ ¿?¡!\"'\`]//g")
    text=$(sed -E "s/ +/ /g; s/^ +//g; s/ +$//g" <<<"$text")
    printf "%s" "$text"
}

_clean_artist() {
    local artist=$1
    artist=$(sed -E "s/[,/].*//g" <<<"$artist")
    artist=$(_sanitize_special_chars "$artist")
    printf "%s" "$artist"
}

_detect_sub_lang() {
    local name=$1
    local name_lower="${name,,}"
    local lang=""
    local modifier=""

    if [[ "$name_lower" =~ (latino|latin|lat|\.lat\.) ]] || [[ "$name_lower" =~ \.lat\.[a-z0-9]+$ ]]; then
        lang="lat"
    elif [[ "$name_lower" =~ (spanish|castellano|español|esp|cas|spa|\.es\.) ]] || [[ "$name_lower" =~ \.es\.[a-z0-9]+$ ]] || [[ "$name_lower" =~ ^spa\. ]]; then
        lang="es"
    elif [[ "$name_lower" =~ (english|eng|\.en\.) ]] || [[ "$name_lower" =~ \.en\.[a-z0-9]+$ ]] || [[ "$name_lower" =~ ^eng\. ]]; then
        lang="en"
    elif [[ "$name_lower" =~ (french|francais|fre|fra|canadian|\.fr\.) ]] || [[ "$name_lower" =~ \.fr\.[a-z0-9]+$ ]]; then
        lang="fr"
    elif [[ "$name_lower" =~ (german|deutsch|ger|deu|\.de\.) ]] || [[ "$name_lower" =~ \.de\.[a-z0-9]+$ ]] || [[ "$name_lower" =~ ^ger\. ]]; then
        lang="de"
    elif [[ "$name_lower" =~ (italian|ita|\.it\.) ]] || [[ "$name_lower" =~ \.it\.[a-z0-9]+$ ]]; then
        lang="it"
    elif [[ "$name_lower" =~ (portuguese|por|pt|\.pt\.) ]] || [[ "$name_lower" =~ \.pt\.[a-z0-9]+$ ]]; then
        lang="pt"
    elif [[ "$name_lower" =~ (swedish|swe|sv|\.sv\.) ]] || [[ "$name_lower" =~ \.sv\.[a-z0-9]+$ ]] || [[ "$name_lower" =~ ^swe\. ]]; then
        lang="sv"
    fi

    if [[ "$name_lower" =~ forced ]]; then
        modifier=".forced"
    elif [[ "$name_lower" =~ sdh ]]; then
        modifier=".sdh"
    elif [[ "$name_lower" =~ \b(hi|cc)\b ]]; then
        modifier=".hi"
    fi

    if [[ -n "$lang" ]]; then
        printf "%s.%s" "$modifier" "$lang"
    elif [[ -n "$modifier" ]]; then
        printf "%s" "$modifier"
    else
        printf ""
    fi
}

_get_audio_metadata() {
    local file=$1
    if _command_exists "ffprobe"; then
        ffprobe -v quiet -print_format json -show_format "$file" 2>/dev/null | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
    tags = data.get("format", {}).get("tags", {})
    artist = tags.get("artist") or tags.get("album_artist") or ""
    album = tags.get("album") or ""
    title = tags.get("title") or ""
    print(f"ARTIST:{artist}")
    print(f"ALBUM:{album}")
    print(f"TITLE:{title}")
except Exception:
    pass
' 2>/dev/null
    fi
}

_get_online_book_metadata() {
    local query=$1
    [[ -z "$query" ]] && return 1

    python3 -c '
import urllib.request, urllib.parse, json, sys, re

q = sys.argv[1]

# Try iTunes Search API for audiobooks & series info first
try:
    url = f"https://itunes.apple.com/search?term={urllib.parse.quote(q)}&entity=audiobook&limit=3"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=2) as resp:
        data = json.loads(resp.read().decode("utf-8"))
        for item in data.get("results", []):
            name = item.get("collectionName") or item.get("trackName") or ""
            artist = item.get("artistName", "")
            desc = item.get("description", "")

            m_name = re.search(r"^(.*?)\s*\((.*?)\s*([0-9]{1,3})\)$", name)
            if m_name:
                print(f"AUTHOR:{artist}")
                print(f"TITLE:{m_name.group(1).strip()}")
                print(f"SAGA_NAME:{m_name.group(2).strip()}")
                print(f"SAGA_NUM:{m_name.group(3).strip()}")
                sys.exit(0)

            m_desc = re.search(r"(?:book|libro|volumen|volume|vol\.?|#)\s*([0-9]{1,3})", desc, re.I)
            m_ordinal = re.search(r"\b(primera|segunda|tercera|cuarta|quinta|sexta|séptima|septima|octava|novena|décima|decima)\s+(?:entrega|novela|libro)\b", desc, re.I)
            ordinal_map = {"primera": "1", "segunda": "2", "tercera": "3", "cuarta": "4", "quinta": "5", "sexta": "6", "séptima": "7", "septima": "7", "octava": "8", "novena": "9", "décima": "10", "decima": "10"}
            num = ""
            if m_desc:
                num = m_desc.group(1)
            elif m_ordinal:
                num = ordinal_map.get(m_ordinal.group(1).lower(), "")

            if num:
                print(f"AUTHOR:{artist}")
                print(f"TITLE:{name}")
                print(f"SAGA_NUM:{num}")
                sys.exit(0)
except Exception:
    pass

# Fallback to Google Books API
try:
    url = f"https://www.googleapis.com/books/v1/volumes?q={urllib.parse.quote(q)}&maxResults=1"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=2) as resp:
        data = json.loads(resp.read().decode("utf-8"))
        if data.get("items"):
            info = data["items"][0].get("volumeInfo", {})
            authors = info.get("authors", [])
            author = authors[0] if authors else ""
            title = info.get("title", "")
            print(f"AUTHOR:{author}")
            print(f"TITLE:{title}")
            sys.exit(0)
except Exception:
    pass
' "$query" 2>/dev/null
}

_parse_audiobook() {
    local file=$1
    local base_dir=$2
    local filename=$(basename -- "$file")
    local ext="${filename##*.}"
    ext="${ext,,}"
    [[ "$filename" != *.* ]] && ext=""

    # 1. Parent directory tree inspection for generic saga hint
    local parent_dir_hint=""
    local curr_dir=$(dirname -- "$file")
    while [[ -n "$curr_dir" ]] && [[ "$curr_dir" != "/" ]]; do
        local d_name=$(basename -- "$curr_dir")
        if [[ "${d_name,,}" =~ (expans|the expanse) ]]; then
            parent_dir_hint="The Expanse"
        elif [[ "$d_name" =~ ^(.*)\ ([0-9]{1,3})$ ]]; then
            parent_dir_hint="${BASH_REMATCH[1]}"
        fi
        [[ "$curr_dir" == "$base_dir" ]] && break
        curr_dir=$(dirname -- "$curr_dir")
    done

    # 2. Check ID3 audio metadata
    local meta=""
    local meta_artist="" meta_album="" meta_title=""
    meta=$(_get_audio_metadata "$file")
    if [[ -n "$meta" ]]; then
        meta_artist=$(grep "^ARTIST:" <<<"$meta" | cut -d: -f2-)
        meta_album=$(grep "^ALBUM:" <<<"$meta" | cut -d: -f2-)
        meta_title=$(grep "^TITLE:" <<<"$meta" | cut -d: -f2-)
    fi

    # 3. Fully generic Python parser with iTunes & Google Books fallback
    python3 - "$filename" "$base_dir" "$ext" "$meta_artist" "$meta_album" "$meta_title" "$parent_dir_hint" << 'EOF_PYTHON'
import json, re, sys, urllib.request, urllib.parse

filename = sys.argv[1]
base_dir = sys.argv[2]
ext = sys.argv[3]
meta_artist = sys.argv[4]
meta_album = sys.argv[5]
meta_title = sys.argv[6]
parent_hint = sys.argv[7]

def sanitize(text):
    if not text:
        return ""
    text = re.sub(r"\*", "-", text)
    text = re.sub(r":", " -", text)
    text = re.sub(r"[ ¿?¡!\"'\`]", "", text)
    text = re.sub(r"\s+", " ", text).strip(" -_.")
    return text

def title_case(text):
    return " ".join(w.capitalize() for w in text.split())

def strip_author_words(text_str, author_str):
    if not author_str:
        return text_str
    words = [re.escape(w) for w in re.sub(r"[\._]", " ", author_str).split() if len(w) > 0]
    if words:
        pattern = r"\b" + r"[\._\s]*".join(words) + r"\b"
        text_str = re.sub(pattern, "", text_str, flags=re.I)
    return text_str

def parse_text_tokens(text_str, parent_saga):
    text_str = re.sub(r"\s+", " ", text_str).strip(" -_")
    saga_n, saga_i, b_title = "", "", text_str

    if parent_saga:
        saga_n = parent_saga

    m_num = re.search(r"\b([0-9]{1,3})\b", text_str)
    if m_num:
        num = m_num.group(1)
        start, end = m_num.span(1)
        before = text_str[:start].strip(" -_")
        after = text_str[end:].strip(" -_")

        if before and after:
            if len(before.split()) <= 3 and "-" not in before:
                saga_n, saga_i, b_title = before, num, after
            elif len(after.split()) <= 3 and "-" not in after:
                b_title, saga_n, saga_i = before, after, num
            else:
                b_title, saga_n, saga_i = before, after, num
        elif before and not after:
            words = before.split()
            if len(words) >= 3:
                saga_n = " ".join(words[-2:])
                b_title = " ".join(words[:-2])
                saga_i = num
            else:
                b_title = before
                saga_i = num
        elif after and not before:
            b_title = after
            saga_i = num

    return saga_n, saga_i, b_title

name_no_ext = re.sub(r"\.[a-z0-9]+$", "", filename, flags=re.I)
text = name_no_ext.replace("_", " ")

author = meta_artist.split(",")[0].split("/")[0].strip() if meta_artist else ""

if author:
    text = strip_author_words(text, author)

saga_name, saga_num, book_title = parse_text_tokens(text, parent_hint)

# Generic iTunes / Google Books API search for missing author or missing saga_num
if not author or not saga_num:
    try:
        q = f"{book_title or name_no_ext} {author}".strip()
        url = f"https://itunes.apple.com/search?term={urllib.parse.quote(q)}&entity=audiobook&limit=3"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=2) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            for item in data.get("results", []):
                name = item.get("collectionName") or item.get("trackName") or ""
                artist = item.get("artistName", "")
                desc = item.get("description", "")

                if not author and artist:
                    author = artist
                    text = strip_author_words(text, author)
                    saga_name, saga_num, book_title = parse_text_tokens(text, parent_hint)

                m_name = re.search(r"^(.*?)\s*\((.*?)\s*([0-9]{1,3})\)$", name)
                if m_name:
                    if not saga_name:
                        saga_name = m_name.group(2).strip()
                    if not saga_num:
                        saga_num = m_name.group(3).strip()
                    break

                m_desc = re.search(r"(?:book|libro|volumen|volume|vol\.?|#)\s*([0-9]{1,3})", desc, re.I)
                m_ordinal = re.search(r"\b(primera|segunda|tercera|cuarta|quinta|sexta|séptima|septima|octava|novena|décima|decima)\s+(?:entrega|novela|libro)\b", desc, re.I)
                ordinal_map = {"primera": "1", "segunda": "2", "tercera": "3", "cuarta": "4", "quinta": "5", "sexta": "6", "séptima": "7", "septima": "7", "octava": "8", "novena": "9", "décima": "10", "decima": "10"}
                if not saga_num:
                    if m_desc:
                        saga_num = m_desc.group(1)
                        break
                    elif m_ordinal:
                        saga_num = ordinal_map.get(m_ordinal.group(1).lower(), "")
                        break
    except Exception:
        pass

if author:
    book_title = strip_author_words(book_title, author)

author = sanitize(author)
saga_name = sanitize(title_case(saga_name))
book_title = sanitize(title_case(book_title))

if saga_num:
    saga_num = f"{int(saga_num):03d}"

if saga_name and saga_num:
    folder_title = f"{saga_name} {saga_num} - {book_title}"
elif saga_name:
    folder_title = f"{saga_name} - {book_title}"
else:
    folder_title = book_title

folder_title = sanitize(folder_title)

if author:
    target_dir = f"{base_dir}/{author}/{folder_title}"
else:
    target_dir = f"{base_dir}/{folder_title}"

if ext:
    target_file = f"{target_dir}/{folder_title}.{ext}"
else:
    target_file = f"{target_dir}/{folder_title}"

print(f"TARGET_DIR:{target_dir}")
print(f"TARGET_FILE:{target_file}")
EOF_PYTHON

    return 0
}

_get_online_movie_year() {
    local title=$1
    [[ -z "$title" ]] && return 1

    python3 -c '
import urllib.request, urllib.parse, json, sys

title = sys.argv[1]
try:
    clean_q = title.lower().replace(" ", "_")
    if clean_q:
        first_char = clean_q[0]
        url = f"https://v2.sg.media-imdb.com/suggestion/{first_char}/{urllib.parse.quote(clean_q)}.json"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=2) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            if data.get("d"):
                for item in data["d"]:
                    if item.get("y"):
                        print(item["y"])
                        sys.exit(0)
except Exception:
    pass
' "$title" 2>/dev/null
}

_find_local_movie_year() {
    local file=$1
    local curr_dir=$(dirname -- "$file")

    while [[ -n "$curr_dir" ]] && [[ "$curr_dir" != "/" ]]; do
        local dir_name=$(basename -- "$curr_dir")
        if [[ "$dir_name" =~ (19[0-9]{2}|20[0-9]{2}) ]]; then
            echo "${BASH_REMATCH[1]}"
            return 0
        fi
        curr_dir=$(dirname -- "$curr_dir")
    done

    local file_dir=$(dirname -- "$file")
    if [[ -d "$file_dir" ]]; then
        local nfo_file=""
        nfo_file=$(find "$file_dir" -maxdepth 2 -type f \( -iname "*.nfo" -o -iname "*.txt" \) 2>/dev/null | head -n 1)
        if [[ -n "$nfo_file" ]]; then
            local year_match=$(grep -oE "\b(19[0-9]{2}|20[0-9]{2})\b" "$nfo_file" 2>/dev/null | head -n 1)
            if [[ -n "$year_match" ]]; then
                echo "$year_match"
                return 0
            fi
        fi
    fi

    return 1
}

_update_or_create_m3u() {
    local target_dir=$1
    local folder_title=$2

    [[ ! -d "$target_dir" ]] && return 0

    local m3u_file=$(find "$target_dir" -maxdepth 1 -type f -iname "*.m3u" | head -n 1)
    local target_m3u="$target_dir/$folder_title.m3u"

    if [[ -n "$m3u_file" ]]; then
        sed -i.bak "s/\*/-/g; s/:/ -/g; s/[ ¿?¡!\"'\`]//g" "$m3u_file" 2>/dev/null
        rm -f "${m3u_file}.bak"
        if [[ "$m3u_file" != "$target_m3u" ]]; then
            mv -f "$m3u_file" "$target_m3u"
        fi
    else
        local audio_files=()
        while IFS= read -r -d '' audio; do
            audio_files+=("$(basename "$audio")")
        done < <(find "$target_dir" -maxdepth 1 -type f \( -iname "*.mp3" -o -iname "*.m4b" -o -iname "*.m4a" -o -iname "*.flac" -o -iname "*.aac" -o -iname "*.ogg" -o -iname "*.wav" \) -print0 | sort -z)

        if ((${#audio_files[@]} > 1)); then
            {
                echo "#EXTM3U"
                for track in "${audio_files[@]}"; do
                    echo "#EXTINF:-1,$track"
                    echo "$track"
                done
            } > "$target_m3u"
        fi
    fi
}

_resolve_media_target() {
    local media_file=$1
    local base_dir=$2
    local filename=$(basename -- "$media_file")
    local filename_lower="${filename,,}"
    local ext="${filename_lower##*.}"

    # Ignore / delete sample clips
    if [[ "$filename_lower" =~ sample ]] && [[ "$ext" =~ ^(mkv|mp4|avi|mov|wmv)$ ]]; then
        echo "DELETE_SAMPLE:1"
        return 0
    fi

    # FOR AUDIOBOOKS (.m4b or audio collection)
    if [[ "$ext" =~ ^(m4b)$ ]] || ([[ "$ext" =~ ^(mp3|m4a|flac|aac|ogg|wav|opus)$ ]] && [[ ! "$filename_lower" =~ s[0-9]{1,2}e[0-9]{1,2} ]]); then
        local curr_dir=$(dirname -- "$media_file")
        local video_count=$(find "$curr_dir" -maxdepth 2 -type f \( -iname "*.mkv" -o -iname "*.mp4" -o -iname "*.avi" -o -iname "*.mov" \) 2>/dev/null | wc -l)
        if ((video_count == 0)); then
            local parsed_output=""
            if parsed_output=$(_parse_audiobook "$media_file" "$base_dir"); then
                echo "$parsed_output"
                return 0
            fi
        fi
    fi

    # FOR SUBTITLE FILES: Check if file explicitly contains movie/show name or climb tree
    if [[ "$ext" =~ ^(srt|ass|vtt|sub|idx)$ ]]; then
        local parsed_output=""
        local target_dir=""
        local target_file=""

        # 1. Check if subtitle filename explicitly contains a TV show SXXEXX code
        if parsed_output=$(_parse_tv_show "$media_file" "$base_dir"); then
            echo "$parsed_output"
            return 0
        fi

        # 2. Check if subtitle filename explicitly contains a Movie WITH A YEAR (e.g. Knights.Of.The.Zodiac.2023...srt)
        local name_no_ext="${filename%.*}"
        if [[ "$name_no_ext" =~ (19[0-9]{2}|20[0-9]{2}) ]]; then
            if parsed_output=$(_parse_movie "$media_file" "$base_dir"); then
                echo "$parsed_output"
                return 0
            fi
        fi

        # 3. Subtitle file is generic or a descriptor (Forced.eng.srt, SDH.eng.srt, ger.srt, spa.srt, etc.)
        # Climb up parent directories to find enclosing video file or release directory
        local curr_dir=$(dirname -- "$media_file")
        while [[ -n "$curr_dir" ]] && [[ "$curr_dir" != "/" ]]; do
            # a) Check if there is any video file in curr_dir (or subdirectories)
            local video_file=""
            video_file=$(find "$curr_dir" -maxdepth 2 -type f \( -iname "*.mkv" -o -iname "*.mp4" -o -iname "*.avi" -o -iname "*.mov" -o -iname "*.wmv" \) -not -iname "*sample*" 2>/dev/null | head -n 1)

            if [[ -n "$video_file" ]]; then
                if parsed_output=$(_parse_tv_show "$video_file" "$base_dir"); then
                    target_dir=$(grep "^TARGET_DIR:" <<<"$parsed_output" | cut -d: -f2-)
                    target_file=$(grep "^TARGET_FILE:" <<<"$parsed_output" | cut -d: -f2-)
                    local lang_suffix=$(_detect_sub_lang "$filename")
                    echo "TARGET_DIR:$target_dir"
                    echo "TARGET_FILE:${target_file%.*}$lang_suffix.$ext"
                    return 0
                fi
                if parsed_output=$(_parse_movie "$video_file" "$base_dir"); then
                    target_dir=$(grep "^TARGET_DIR:" <<<"$parsed_output" | cut -d: -f2-)
                    target_file=$(grep "^TARGET_FILE:" <<<"$parsed_output" | cut -d: -f2-)
                    local lang_suffix=$(_detect_sub_lang "$filename")
                    echo "TARGET_DIR:$target_dir"
                    echo "TARGET_FILE:${target_file%.*}$lang_suffix.$ext"
                    return 0
                fi
            fi

            # b) Check if curr_dir folder name itself parses as TV show or Movie (with year or valid title)
            local dir_name=$(basename -- "$curr_dir")
            local clean_dir_name=$(_strip_junk_tags "$dir_name")
            if [[ -n "$clean_dir_name" ]] && [[ "${clean_dir_name,,}" != "subs" ]] && [[ "${clean_dir_name,,}" != "subtitles" ]]; then
                if parsed_output=$(_parse_tv_show "$curr_dir" "$base_dir"); then
                    target_dir=$(grep "^TARGET_DIR:" <<<"$parsed_output" | cut -d: -f2-)
                    target_file=$(grep "^TARGET_FILE:" <<<"$parsed_output" | cut -d: -f2-)
                    local lang_suffix=$(_detect_sub_lang "$filename")
                    echo "TARGET_DIR:$target_dir"
                    echo "TARGET_FILE:${target_file%.*}$lang_suffix.$ext"
                    return 0
                fi
                if [[ "$dir_name" =~ (19[0-9]{2}|20[0-9]{2}) ]]; then
                    if parsed_output=$(_parse_movie "$curr_dir" "$base_dir"); then
                        target_dir=$(grep "^TARGET_DIR:" <<<"$parsed_output" | cut -d: -f2-)
                        target_file=$(grep "^TARGET_FILE:" <<<"$parsed_output" | cut -d: -f2-)
                        local lang_suffix=$(_detect_sub_lang "$filename")
                        echo "TARGET_DIR:$target_dir"
                        echo "TARGET_FILE:${target_file%.*}$lang_suffix.$ext"
                        return 0
                    fi
                fi
            fi

            [[ "$curr_dir" == "$base_dir" ]] && break
            curr_dir=$(dirname -- "$curr_dir")
        done

        # Fallback if no enclosing video/movie folder could be found
        if parsed_output=$(_parse_movie "$media_file" "$base_dir"); then
            echo "$parsed_output"
            return 0
        fi
        return 1
    fi

    # FOR VIDEO FILES: Try TV show then Movie
    local parsed_output=""
    if parsed_output=$(_parse_tv_show "$media_file" "$base_dir"); then
        echo "$parsed_output"
        return 0
    fi

    if parsed_output=$(_parse_movie "$media_file" "$base_dir"); then
        echo "$parsed_output"
        return 0
    fi

    return 1
}

_is_release_folder() {
    local dir=$1
    local dir_name=$(basename -- "$dir")
    local dir_lower="${dir_name,,}"

    # Generic collection/category directory names are never single-release folders
    if [[ "$dir_lower" =~ ^(peliculas|películas|movies|cine|series|tv|shows|tvshows|audiobooks|audiolibros|libros|books|descargas|downloads|torrents|complete|completos|musica|música|music|anime|documentales|documentaries)$ ]]; then
        return 1
    fi

    # 1. TV show episode/season release folder (e.g. The.Ark.S03E03.1080p.x265-ELiTE or Silo.S03)
    if [[ "$dir_lower" =~ s[0-9]{1,2}e[0-9]{1,2} ]] ||
       [[ "$dir_lower" =~ [^0-9][0-9]{1,2}x[0-9]{1,2} ]] ||
       [[ "$dir_lower" =~ (temp|temporada)[\._\ -]?[0-9]{1,2}.*(cap|episodio|ep)[\._\ -]?[0-9]{1,4} ]]; then
        return 0
    fi

    # 2. Movie release folder with Year AND rip/quality/codec/group tags
    if [[ "$dir_name" =~ (19[0-9]{2}|20[0-9]{2}) ]] &&
       [[ "$dir_lower" =~ (1080p|720p|2160p|4k|uhd|bluray|bdrip|brrip|web-dl|webrip|hdtv|dvdrip|x264|x265|hevc|xvid|divx|remux|microhd|elite|rarbg|yts|eztv|tgx) ]]; then
        return 0
    fi

    # 3. Folder name has quality/release tags (e.g. 1080p, x265, WEB-DL, etc.)
    if [[ "$dir_lower" =~ (1080p|720p|2160p|4k|uhd|bluray|bdrip|brrip|web-dl|webrip|hdtv|dvdrip|x264|x265|hevc|xvid|divx|remux|microhd) ]]; then
        return 0
    fi

    return 1
}

_generate_plan() {
    local input_files=$1
    local moves=""
    local deletions=""

    local move_count=0
    local del_count=0

    declare -A seen_targets

    while IFS= read -r item; do
        [[ -z "$item" ]] && continue
        [[ ! -e "$item" ]] && continue

        local base_dir=""
        if [[ -d "$item" ]]; then
            if _is_release_folder "$item"; then
                base_dir=$(dirname -- "$item")
            else
                base_dir="$item"
            fi
        else
            base_dir=$(dirname -- "$item")
        fi

        if [[ -d "$item" ]]; then
            # Check junk files
            while IFS= read -r -d '' junk; do
                del_count=$((del_count + 1))
                deletions+="[DELETE] $junk\n"
            done < <(find "$item" -type f \( -iname "*.nfo" -o -iname "*.txt" -o -iname "*.jpg" -o -iname "*.png" -o -iname "*.url" \) -print0 2>/dev/null)

            # Check media files
            while IFS= read -r -d '' media; do
                local parsed_output=""

                if parsed_output=$(_resolve_media_target "$media" "$base_dir"); then
                    if grep -q "^DELETE_SAMPLE:1" <<<"$parsed_output"; then
                        del_count=$((del_count + 1))
                        deletions+="[DELETE SAMPLE] $media\n"
                        continue
                    fi

                    local target_file=$(grep "^TARGET_FILE:" <<<"$parsed_output" | cut -d: -f2-)
                    if [[ -n "$target_file" ]]; then
                        if [[ "$media" == "$target_file" ]]; then
                            seen_targets["$target_file"]=1
                        else
                            # Disambiguate colliding targets
                            if [[ -n "${seen_targets["$target_file"]:-}" ]]; then
                                local count=$((seen_targets["$target_file"] + 1))
                                seen_targets["$target_file"]=$count
                                local base="${target_file%.*}"
                                local ext="${target_file##*.}"
                                target_file="${base}.${count}.${ext}"
                            else
                                seen_targets["$target_file"]=1
                            fi

                            if [[ "$media" != "$target_file" ]]; then
                                move_count=$((move_count + 1))
                                moves+="[MOVE] $media\n    -> $target_file\n\n"
                            fi
                        fi
                    fi
                fi
            done < <(find "$item" -type f \( -iname "*.mkv" -o -iname "*.mp4" -o -iname "*.avi" -o -iname "*.mov" -o -iname "*.wmv" -o -iname "*.m4v" -o -iname "*.flv" -o -iname "*.ts" -o -iname "*.srt" -o -iname "*.ass" -o -iname "*.vtt" -o -iname "*.sub" -o -iname "*.idx" -o -iname "*.m4b" -o -iname "*.mp3" -o -iname "*.m4a" -o -iname "*.flac" -o -iname "*.aac" -o -iname "*.ogg" -o -iname "*.wav" \) -print0 2>/dev/null)
        elif [[ -f "$item" ]]; then
            local parsed_output=""

            if parsed_output=$(_resolve_media_target "$item" "$base_dir"); then
                local target_file=$(grep "^TARGET_FILE:" <<<"$parsed_output" | cut -d: -f2-)
                if [[ -n "$target_file" ]]; then
                    if [[ "$item" == "$target_file" ]]; then
                        seen_targets["$target_file"]=1
                    else
                        if [[ -n "${seen_targets["$target_file"]:-}" ]]; then
                            local count=$((seen_targets["$target_file"] + 1))
                            seen_targets["$target_file"]=$count
                            local base="${target_file%.*}"
                            local ext="${target_file##*.}"
                            target_file="${base}.${count}.${ext}"
                        else
                            seen_targets["$target_file"]=1
                        fi

                        if [[ "$item" != "$target_file" ]]; then
                            move_count=$((move_count + 1))
                            moves+="[MOVE] $item\n    -> $target_file\n\n"
                        fi
                    fi
                fi
            fi
        fi
    done < <(tr "\r" "\n" <<<"$input_files")

    {
        echo "================================================================================"
        echo "                    CLEAN UP DOWNLOADS - PROPOSED PLAN"
        echo "================================================================================"
        echo ""
        echo "SUMMARY:"
        echo "  - Media Files to Move/Rename: $move_count"
        echo "  - Junk Files to Delete:       $del_count"
        echo ""
        if [[ -n "$moves" ]]; then
            echo "--------------------------------------------------------------------------------"
            echo "PROPOSED MEDIA RELOCATIONS:"
            echo "--------------------------------------------------------------------------------"
            echo -e "$moves"
        fi
        if [[ -n "$deletions" ]]; then
            echo "--------------------------------------------------------------------------------"
            echo "PROPOSED JUNK DELETIONS:"
            echo "--------------------------------------------------------------------------------"
            echo -e "$deletions"
        fi
        echo "================================================================================"
        echo "Press \"Apply Plan\" to proceed with these changes or "Cancel" to abort."
    } > "$TEMP_DATA_TEXT_BOX"

    return "$((move_count + del_count))"
}

_title_case() {
    local input=$1
    local output=""
    local word=""
    for word in $input; do
        output="${output}${word^} "
    done
    printf "%s" "${output% }"
}

_strip_junk_tags() {
    local text=$1
    # Replace newlines, carriage returns, tabs with spaces
    text=$(tr '\r\n\t' '   ' <<<"$text")
    # Strip any bracketed block like [Rip], [5.1 Castellano], [1080p], [Dual], etc.
    text=$(sed -E 's/\[[^]]*\]//g' <<<"$text")
    # Strip parenthetical blocks containing junk, quality, audio, resolution, language, or website terms
    text=$(sed -E 's/\([^)]*(hdr|rip|web|dl|dvd|bd|bluray|1080|720|4k|2160|castellano|spanish|español|latino|english|eng|esp|dual|multi|torrent|com|net|org|es|me|co|io|cc|site|www)[^)]*\)//gI' <<<"$text")
    # Strip domain names & URLs before replacing dots/underscores
    text=$(sed -E 's/\b(www\.)?[A-Za-z0-9-]+\.(com|net|org|es|me|co|io|cc|info|biz|tv|to|mx)\b//gI' <<<"$text")
    # Replace dots and underscores with spaces
    text=$(sed -E 's/[\._]/ /g' <<<"$text")
    # Strip resolution indicators
    text=$(sed -E 's/\b(1080p?|720p?|2160p?|4k|uhd|480p?|576p?|1080i)\b//gI' <<<"$text")
    # Strip codecs & formats
    text=$(sed -E 's/\b(x264|x265|h264|h265|hevc|avc|xvid|divx|10bit|8bit|hdr10\+?|hdr|dv|dovi)\b//gI' <<<"$text")
    # Strip sources & rip tags
    text=$(sed -E 's/\b(web-?dl|web-?rip|web-?hd|web|bluray|bd-?rip|brrip|hdtv|hdtvrip|dvd-?rip|dvd-?scr|screener|scr|hd-?rip|hd-?ts|hd-?tc|cam-?rip|cam|telecine|tc|tele-?sync|ts|vodrip|satrip|remux|rip|microhd)\b//gI' <<<"$text")
    # Strip audio tags
    text=$(sed -E 's/\b(aac|dts(-?hd)?|truehd|atmos|dd5\.?1|ac3|5\.1|7\.1|5 1|7 1|flac|mp3|eac3)\b//gI' <<<"$text")
    # Strip languages & audio/sub tags
    text=$(sed -E 's/\b(castellano|spanish|español|latino|english|eng|esp|dual|multi|subbed|dubbed|subs?)\b//gI' <<<"$text")
    # Strip release details & revisions
    text=$(sed -E 's/\b(proper|repack|extended|uncut|directors\.?cut)\b//gI' <<<"$text")
    # Strip common site names / release group tags
    text=$(sed -E 's/\b(elitetorrent|divxtotal|pctreload|pctestrenos|torrentestrenos|subtorrents|newpct|descargaya|rarbg|yts|eztv|1337x|tgx)\b//gI' <<<"$text")
    # Strip trailing release group indicators (e.g. -GROUP or -RARBG)
    text=$(sed -E 's/ - [A-Za-z0-9]+$//g; s/-[A-Za-z0-9]+$//g' <<<"$text")
    # Clean up empty parens and brackets
    text=$(sed -E 's/\(\s*\)//g; s/\[\s*\]//g' <<<"$text")
    # Clean up leading/trailing punctuation, parens, brackets, dashes, and dots
    text=$(sed -E 's/[- \(\[\._]+$//g; s/^[- \(\[\._]+//g' <<<"$text")
    text=$(sed -E 's/ +/ /g' <<<"$text")
    printf "%s" "$text"
}

_parse_tv_show() {
    local file=$1
    local base_dir=$2
    local filename=$(basename -- "$file")
    local name_no_ext="${filename%.*}"
    local ext="${filename##*.}"
    ext="${ext,,}"
    [[ "$filename" != *.* ]] && ext=""

    local lang_suffix=""
    if [[ "$ext" =~ ^(srt|ass|vtt|sub|idx)$ ]]; then
        lang_suffix=$(_detect_sub_lang "$filename")
        if [[ "$name_no_ext" =~ \.(es|en|fr|de|it|pt|sv|lat|spa|eng|cas|castellano|spanish|english|fre|fra|ger|deu|ita|por|jpn|swe|forced|sdh|hi)$ ]]; then
            name_no_ext="${name_no_ext%.*}"
        fi
        if [[ "$name_no_ext" =~ \.(forced|sdh|hi|cc)$ ]]; then
            name_no_ext="${name_no_ext%.*}"
        fi
    fi

    local show_name=""
    local s=""
    local e=""
    local episode_str=""
    local season_str=""

    shopt -s nocasematch

    # Pattern 1: Standard S02E04 or S2E4
    if [[ "$name_no_ext" =~ (.*)s([0-9]{1,2})e([0-9]{1,2})(-?e?[0-9]{1,2})?(.*) ]]; then
        show_name="${BASH_REMATCH[1]}"
        s="${BASH_REMATCH[2]}"
        e="${BASH_REMATCH[3]}"
        local extra="${BASH_REMATCH[4]}"
        printf -v season_str "S%02d" "$((10#$s))"
        printf -v episode_str "S%02dE%02d" "$((10#$s))" "$((10#$e))"
        if [[ -n "$extra" ]]; then
            extra=$(tr '[:lower:]' '[:upper:]' <<<"$extra")
            if [[ "$extra" =~ ^-([0-9]+)$ ]]; then
                printf -v episode_str "%s-E%02d" "$episode_str" "$((10#${BASH_REMATCH[1]}))"
            elif [[ "$extra" =~ ^E([0-9]+)$ ]]; then
                printf -v episode_str "%sE%02d" "$episode_str" "$((10#${BASH_REMATCH[1]}))"
            elif [[ "$extra" =~ ^-E([0-9]+)$ ]]; then
                printf -v episode_str "%s-E%02d" "$episode_str" "$((10#${BASH_REMATCH[1]}))"
            fi
        fi
    # Pattern 2: Standard 2x04 or 02x04
    elif [[ "$name_no_ext" =~ (.*)[^0-9]([0-9]{1,2})x([0-9]{1,2})(.*) ]]; then
        show_name="${BASH_REMATCH[1]}"
        s="${BASH_REMATCH[2]}"
        e="${BASH_REMATCH[3]}"
        printf -v season_str "S%02d" "$((10#$s))"
        printf -v episode_str "S%02dE%02d" "$((10#$s))" "$((10#$e))"
    # Pattern 3: Spanish / International Temp.X ... Cap.Y or Cap.SEE (e.g. Temp.2 [Cap.204] or Cap.204)
    elif [[ "$name_no_ext" =~ (.*)[\.\_\ \-\[\(](t|temp\.|temp|temporada)[\.\_\ ]?([0-9]{1,2}).*[\.\_\ \-\[\(](cap\.|cap|capitulo|capítulo|ep\.|ep|episodio)[\.\_\ ]?([0-9]{1,4}) ]] || [[ "$name_no_ext" =~ (.*)[\.\_\ \-\[\(](cap\.|cap|capitulo|capítulo)[\.\_\ ]?([0-9]{3,4}) ]]; then
        if [[ -n "${BASH_REMATCH[5]:-}" ]]; then
            show_name="${BASH_REMATCH[1]}"
            s="${BASH_REMATCH[3]}"
            local raw_e="${BASH_REMATCH[5]}"
            if ((${#raw_e} == 3)) && [[ "$raw_e" == "$s"* ]]; then
                e="${raw_e:1:2}"
            elif ((${#raw_e} == 4)) && [[ "$raw_e" == "$s"* ]]; then
                e="${raw_e:2:2}"
            else
                e="$raw_e"
            fi
        else
            show_name="${BASH_REMATCH[1]}"
            local raw_code="${BASH_REMATCH[3]}"
            if ((${#raw_code} == 3)); then
                s="${raw_code:0:1}"
                e="${raw_code:1:2}"
            elif ((${#raw_code} == 4)); then
                s="${raw_code:0:2}"
                e="${raw_code:2:2}"
            fi
        fi
        printf -v season_str "S%02d" "$((10#$s))"
        printf -v episode_str "S%02dE%02d" "$((10#$s))" "$((10#$e))"
    else
        shopt -u nocasematch
        return 1
    fi
    shopt -u nocasematch

    show_name=$(_strip_junk_tags "$show_name")
    show_name=$(_title_case "$show_name")

    if [[ -n "$show_name" ]]; then
        local target_dir="$base_dir/$show_name $season_str"
        local target_file=""
        if [[ -n "$ext" ]]; then
            target_file="$target_dir/$show_name $episode_str$lang_suffix.$ext"
        else
            target_file="$target_dir/$show_name $episode_str"
        fi
        echo "TARGET_DIR:$target_dir"
        echo "TARGET_FILE:$target_file"
        return 0
    fi
    return 1
}

_parse_movie() {
    local file=$1
    local base_dir=$2
    local filename=$(basename -- "$file")
    local name_no_ext="${filename%.*}"
    local ext="${filename##*.}"
    ext="${ext,,}"
    [[ "$filename" != *.* ]] && ext=""

    local lang_suffix=""
    if [[ "$ext" =~ ^(srt|ass|vtt|sub|idx)$ ]]; then
        lang_suffix=$(_detect_sub_lang "$filename")
        if [[ "$name_no_ext" =~ \.(es|en|fr|de|it|pt|sv|lat|spa|eng|cas|castellano|spanish|english|fre|fra|ger|deu|ita|por|jpn|swe|forced|sdh|hi)$ ]]; then
            name_no_ext="${name_no_ext%.*}"
        fi
        if [[ "$name_no_ext" =~ \.(forced|sdh|hi|cc)$ ]]; then
            name_no_ext="${name_no_ext%.*}"
        fi
    fi

    local movie_name=""
    local year=""

    if [[ "$name_no_ext" =~ (.*)[\.\_\ \(\[]?(19[0-9]{2}|20[0-9]{2})[\.\_\ \)\}]?(.*) ]]; then
        movie_name="${BASH_REMATCH[1]}"
        year="${BASH_REMATCH[2]}"
    else
        movie_name="$name_no_ext"
        year=""
    fi

    movie_name=$(_strip_junk_tags "$movie_name")
    movie_name=$(_title_case "$movie_name")

    if [[ -z "$year" ]] && [[ -n "$movie_name" ]]; then
        year=$(_find_local_movie_year "$file")
        if [[ -z "$year" ]]; then
            year=$(_get_online_movie_year "$movie_name")
        fi
    fi

    if [[ -n "$movie_name" ]]; then
        local target_dir=""
        local target_file=""
        if [[ -n "$year" ]]; then
            target_dir="$base_dir/$movie_name ($year)"
            if [[ -n "$ext" ]]; then
                target_file="$target_dir/$movie_name ($year)$lang_suffix.$ext"
            else
                target_file="$target_dir/$movie_name ($year)"
            fi
        else
            target_dir="$base_dir/$movie_name"
            if [[ -n "$ext" ]]; then
                target_file="$target_dir/$movie_name$lang_suffix.$ext"
            else
                target_file="$target_dir/$movie_name"
            fi
        fi
        echo "TARGET_DIR:$target_dir"
        echo "TARGET_FILE:$target_file"
        return 0
    fi
    return 1
}

_clean_up_single_media() {
    local media_file=$1
    local base_dir=$2
    local container_dir=$3

    local filename=$(basename -- "$media_file")
    local filename_lower="${filename,,}"

    # Delete sample video clips
    if [[ "$filename_lower" =~ sample ]] && [[ "${filename_lower##*.}" =~ ^(mkv|mp4|avi|mov|wmv)$ ]]; then
        rm -f "$media_file"
        return 0
    fi

    local parsed_output=""
    if parsed_output=$(_resolve_media_target "$media_file" "$base_dir"); then
        if grep -q "^DELETE_SAMPLE:1" <<<"$parsed_output"; then
            rm -f "$media_file"
            return 0
        fi

        local target_dir=$(grep "^TARGET_DIR:" <<<"$parsed_output" | cut -d: -f2-)
        local target_file=$(grep "^TARGET_FILE:" <<<"$parsed_output" | cut -d: -f2-)

        if [[ -n "$target_dir" ]] && [[ -n "$target_file" ]] && [[ "$media_file" != "$target_file" ]]; then
            mkdir -p "$target_dir"
            _move_file "skip" "$media_file" "$target_file"
            _update_or_create_m3u "$target_dir" "$(basename "$target_dir")"
        fi
    fi
}

_clean_up_item() {
    local item=$1

    if [[ ! -e "$item" ]]; then
        return 0
    fi

    local base_dir=""
    if [[ -d "$item" ]]; then
        if _is_release_folder "$item"; then
            base_dir=$(dirname -- "$item")
        else
            base_dir="$item"
        fi
    else
        base_dir=$(dirname -- "$item")
    fi

    if [[ -d "$item" ]]; then
        # Remove metadata junk files safely
        find "$item" -type f \( -iname "*.nfo" -o -iname "*.txt" -o -iname "*.jpg" -o -iname "*.png" -o -iname "*.url" \) -delete 2>/dev/null
        find "$item" -type d \( -iname "screens" -o -iname "screenshots" -o -iname "sample" -o -iname "samples" \) -exec rm -rf {} + 2>/dev/null

        # Extract archives if present inside directory
        shopt -s nullglob
        local archives=("$item"/*.rar "$item"/*.zip "$item"/*.7z "$item"/*.tar.gz)
        shopt -u nullglob

        if ((${#archives[@]} > 0)); then
            local extract_script="${ROOT_DIR}/Archive/Extract here"
            if [[ -f "$extract_script" ]]; then
                for arch in "${archives[@]}"; do
                    bash "$extract_script" "$arch" 2>/dev/null
                done
            fi
        fi

        # Find and process all media files recursively
        local media_files=()
        while IFS= read -r -d '' media; do
            media_files+=("$media")
        done < <(find "$item" -type f \( -iname "*.mkv" -o -iname "*.mp4" -o -iname "*.avi" -o -iname "*.mov" -o -iname "*.wmv" -o -iname "*.m4v" -o -iname "*.flv" -o -iname "*.ts" -o -iname "*.srt" -o -iname "*.ass" -o -iname "*.vtt" -o -iname "*.sub" -o -iname "*.idx" -o -iname "*.m4b" -o -iname "*.mp3" -o -iname "*.m4a" -o -iname "*.flac" -o -iname "*.aac" -o -iname "*.ogg" -o -iname "*.wav" \) -print0)

        for media in "${media_files[@]}"; do
            _clean_up_single_media "$media" "$base_dir" "$item"
        done

        # Remove empty subdirectories left behind
        find "$item" -depth -mindepth 1 -type d -empty -delete 2>/dev/null
        rmdir "$item" 2>/dev/null
    elif [[ -f "$item" ]]; then
        _clean_up_single_media "$item" "$base_dir" ""
    fi
}

_main_task() {
    local input_file=$1
    local output_dir=$2

    _clean_up_item "$input_file"
}

_main "$@"
