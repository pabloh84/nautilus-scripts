#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2001

# Source the script '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local output_dir=""

    # Execute initial checks.
    _check_dependencies ""
    _display_wait_box
    input_files=$(_get_files "par_type=all")

    # Export functions for parallel execution worker processes.
    export -f _main_task \
        _clean_up_item \
        _clean_directory \
        _parse_tv_show \
        _parse_movie \
        _strip_junk_tags \
        _title_case

    # Execute the function '_main_task' for each item in parallel.
    _run_task_parallel "$input_files" "$output_dir"
    _display_result_box ""
}

_title_case() {
    local input=$1
    local output=""
    local word=""
    for word in $input; do
        output="${output}${word^} "
    done
    printf "%s" "${output% }"
}

_strip_junk_tags() {
    local text=$1
    # Strip any bracketed block like [Rip], [5.1 Castellano], [1080p], [Dual], etc.
    text=$(sed -E 's/\[[^]]*\]//g' <<<"$text")
    # Replace dots and underscores with spaces
    text=$(sed -E 's/[\._]/ /g' <<<"$text")
    # Strip resolution indicators
    text=$(sed -E 's/\b(1080p?|720p?|2160p?|4k|uhd|480p?|576p?|1080i)\b//gI' <<<"$text")
    # Strip codecs & formats
    text=$(sed -E 's/\b(x264|x265|h264|h265|hevc|avc|xvid|divx|10bit|8bit|hdr10\+?|hdr|dv|dovi)\b//gI' <<<"$text")
    # Strip sources & rip tags
    text=$(sed -E 's/\b(web-?dl|web-?rip|web|bluray|bdrip|brrip|hdtv|dvdrip|remux|rip|microhd)\b//gI' <<<"$text")
    # Strip audio tags
    text=$(sed -E 's/\b(aac|dts(-?hd)?|truehd|atmos|dd5\.?1|ac3|5\.1|7\.1|5 1|7 1|flac|mp3)\b//gI' <<<"$text")
    # Strip languages & audio/sub tags
    text=$(sed -E 's/\b(castellano|spanish|español|latino|english|eng|esp|dual|multi|subbed|dubbed|subs?)\b//gI' <<<"$text")
    # Strip release details & revisions
    text=$(sed -E 's/\b(proper|repack|extended|uncut|directors\.?cut)\b//gI' <<<"$text")
    # Strip trailing release group indicators (e.g. -GROUP or -RARBG)
    text=$(sed -E 's/ - [A-Za-z0-9]+$//g; s/-[A-Za-z0-9]+$//g' <<<"$text")
    # Clean up leading/trailing punctuation and parens/brackets/dashes
    text=$(sed -E 's/[ \(\[\-\._]+$//g; s/^[ \(\[\-\._]+//g' <<<"$text")
    text=$(sed -E 's/ +/ /g' <<<"$text")
    printf "%s" "$text"
}

_parse_tv_show() {
    local file=$1
    local filename=""
    local dir=""
    local name_no_ext=""
    local ext=""

    filename=$(basename -- "$file")
    dir=$(dirname -- "$file")

    if [[ -d "$file" ]]; then
        name_no_ext="$filename"
        ext=""
    else
        name_no_ext="${filename%.*}"
        ext="${filename##*.}"
        [[ "$filename" != *.* ]] && ext=""
    fi

    local show_name=""
    local episode_str=""

    if [[ "$name_no_ext" =~ (.*)[Ss]([0-9]{1,2})[Ee]([0-9]{1,2})(-?[Ee]?[0-9]{1,2})?(.*) ]]; then
        show_name="${BASH_REMATCH[1]}"
        local s="${BASH_REMATCH[2]}"
        local e="${BASH_REMATCH[3]}"
        local extra="${BASH_REMATCH[4]}"
        printf -v episode_str "S%02dE%02d" "$((10#$s))" "$((10#$e))"
        if [[ -n "$extra" ]]; then
            extra=$(tr '[:lower:]' '[:upper:]' <<<"$extra")
            if [[ "$extra" =~ ^-([0-9]+)$ ]]; then
                printf -v episode_str "%s-E%02d" "$episode_str" "$((10#${BASH_REMATCH[1]}))"
            elif [[ "$extra" =~ ^E([0-9]+)$ ]]; then
                printf -v episode_str "%sE%02d" "$episode_str" "$((10#${BASH_REMATCH[1]}))"
            elif [[ "$extra" =~ ^-E([0-9]+)$ ]]; then
                printf -v episode_str "%s-E%02d" "$episode_str" "$((10#${BASH_REMATCH[1]}))"
            fi
        fi
    elif [[ "$name_no_ext" =~ (.*)[^0-9]([0-9]{1,2})x([0-9]{1,2})(.*) ]]; then
        show_name="${BASH_REMATCH[1]}"
        local s="${BASH_REMATCH[2]}"
        local e="${BASH_REMATCH[3]}"
        printf -v episode_str "S%02dE%02d" "$((10#$s))" "$((10#$e))"
    else
        return 1
    fi

    show_name=$(_strip_junk_tags "$show_name")
    show_name=$(_title_case "$show_name")

    if [[ -n "$show_name" ]]; then
        if [[ -n "$ext" ]]; then
            printf "%s/%s %s.%s" "$dir" "$show_name" "$episode_str" "${ext,,}"
        else
            printf "%s/%s %s" "$dir" "$show_name" "$episode_str"
        fi
        return 0
    fi
    return 1
}

_parse_movie() {
    local file=$1
    local filename=""
    local dir=""
    local name_no_ext=""
    local ext=""

    filename=$(basename -- "$file")
    dir=$(dirname -- "$file")

    if [[ -d "$file" ]]; then
        name_no_ext="$filename"
        ext=""
    else
        name_no_ext="${filename%.*}"
        ext="${filename##*.}"
        [[ "$filename" != *.* ]] && ext=""
    fi

    local movie_name=""
    local year=""

    if [[ "$name_no_ext" =~ (.*)[\.\_\ \(\[]?(19[0-9]{2}|20[0-9]{2})[\.\_\ \)\}]?(.*) ]]; then
        movie_name="${BASH_REMATCH[1]}"
        year="${BASH_REMATCH[2]}"
    else
        return 1
    fi

    movie_name=$(_strip_junk_tags "$movie_name")
    movie_name=$(_title_case "$movie_name")

    if [[ -n "$movie_name" ]]; then
        if [[ -n "$ext" ]]; then
            printf "%s/%s (%s).%s" "$dir" "$movie_name" "$year" "${ext,,}"
        else
            printf "%s/%s (%s)" "$dir" "$movie_name" "$year"
        fi
        return 0
    fi
    return 1
}

_clean_directory() {
    local dir_path=$1

    # Remove metadata junk files safely (.nfo, .txt, .jpg, .png, .url)
    rm -f "$dir_path"/*.nfo "$dir_path"/*.txt "$dir_path"/*.jpg "$dir_path"/*.png "$dir_path"/*.url "$dir_path"/*.URL 2>/dev/null
    rm -rf "$dir_path"/[Ss]creens "$dir_path"/[Ss]creenshots 2>/dev/null

    # Extract archives if present inside directory
    shopt -s nullglob
    local archives=("$dir_path"/*.rar "$dir_path"/*.zip "$dir_path"/*.7z "$dir_path"/*.tar.gz)
    shopt -u nullglob

    if ((${#archives[@]} > 0)); then
        local extract_script="${ROOT_DIR}/Archive/Extract here"
        if [[ -f "$extract_script" ]]; then
            for arch in "${archives[@]}"; do
                bash "$extract_script" "$arch" 2>/dev/null
            done
        fi
    fi

    # Process media files inside directory
    shopt -s nullglob
    local media_files=("$dir_path"/*.mkv "$dir_path"/*.mp4 "$dir_path"/*.avi "$dir_path"/*.mov "$dir_path"/*.wmv "$dir_path"/*.m4v "$dir_path"/*.flv "$dir_path"/*.ts)
    shopt -u nullglob

    for media in "${media_files[@]}"; do
        _clean_up_item "$media"
    done

    # Rename directory itself if it matches a movie pattern
    local new_dir_path=""
    if new_dir_path=$(_parse_movie "$dir_path"); then
        _move_file "skip" "$dir_path" "$new_dir_path"
    fi
}

_clean_up_item() {
    local item=$1

    if [[ -d "$item" ]]; then
        _clean_directory "$item"
    elif [[ -f "$item" ]]; then
        local new_path=""
        if new_path=$(_parse_tv_show "$item"); then
            _move_file "skip" "$item" "$new_path"
        elif new_path=$(_parse_movie "$item"); then
            _move_file "skip" "$item" "$new_path"
        fi
    fi
}

_main_task() {
    local input_file=$1
    local output_dir=$2

    _clean_up_item "$input_file"
}

_main "$@"
